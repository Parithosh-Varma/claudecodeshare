{
  "name": "second-seat",
  "version": "0.2.0",
  "description": "Share your machine, keep your keys: revocable, expiring share links to a live terminal on your dev box",
  "type": "module",
  "bin": {
    "second-seat": "./bin/second-seat.js"
  },
  "files": [
    "bin/",
    "agent.js",
    "server.js",
    "share.js",
    "publish.js",
    "tunnel.js",
    "paths.js",
    "test.js",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "bin": {
    "second-seat": "./bin/second-seat.js"
  },
  "files": [
    "bin/",
    "paths.js",
    "server.js",
    "agent.js",
    "share.js",
    "tunnel.js",
    "publish.js",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.js",
    "agent": "node agent.js",
    "share": "node share.js",
    "publish": "node publish.js",
    "test": "node test.js",
    "postinstall": "mkdir -p public/vendor && cp node_modules/xterm/lib/xterm.js node_modules/xterm/css/xterm.css node_modules/@xterm/addon-fit/lib/addon-fit.js public/vendor/ 2>/dev/null; chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null; true",
    "prepack": "node scripts/materialize-public.js",
    "postpack": "node scripts/restore-public.js",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "node-pty": "^1.1.0",
    "ora": "^9.4.1",
    "ws": "^8.18.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}